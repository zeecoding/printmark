<Window x:Class="PrintMark.AdminApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PrintMark.AdminApp" Icon="Assets/PrintMark.ico" Title="PrintMark · Enterprise Studio" Width="1380" Height="900" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI" Foreground="#242424">
 <Window.Resources>
  <SolidColorBrush x:Key="Blue" Color="#0F6CBD"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242424"/><Setter Property="BorderBrush" Value="#DCE1E7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0F6CBD"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0F6CBD"/></Style>
  <Style x:Key="NavigationItem" TargetType="RadioButton">
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#242424"/>
   <Setter Property="BorderBrush" Value="#DCE1E7"/>
   <Setter Property="Padding" Value="16,11"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#F0F3F7"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="#BBC5D1"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#EBF3FC"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="#B9D5EF"/><Setter Property="Foreground" Value="#0F6CBD"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="NavBorder" Property="Background" Value="#DCEBFA"/></MultiTrigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#0F6CBD"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D7DEE7"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,14,0,7"/><Setter Property="Foreground" Value="#596779"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E5EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10,0,0"/></Style>
 </Window.Resources>
 <Grid Background="#F5F7FA"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#FFFFFF" BorderBrush="#E0E5EB" BorderThickness="0,0,1,0"><DockPanel Margin="16,28">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  PrintMark" Foreground="#0F6CBD" FontWeight="Bold" FontSize="26"/><TextBlock Text="ENTERPRISE STUDIO" FontSize="10" Foreground="#778495" Margin="34,5,0,34"/>
    <RadioButton x:Name="HomeNav" Content="⌂   Home" Tag="Home" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="OnNavigationChecked"/>
    <RadioButton x:Name="WatermarkNav" Content="▧   Watermark" Tag="Watermark" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="OnNavigationChecked" IsChecked="True"/>
    <RadioButton x:Name="FleetNav" Content="▦   Printer fleet" Tag="Fleet" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="OnNavigationChecked"/>
    <RadioButton x:Name="DeploymentNav" Content="⎘   Fleet deployment" Tag="Deployment" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="OnNavigationChecked"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><Border Background="#F3F8FD" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="POLICY SERVER" FontSize="10" Foreground="#6A788A"/><TextBlock x:Name="ConnectionText" Text="Connecting…" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="PrintMark · Windows" Foreground="#8791A1" FontSize="11" Margin="5,20,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E0E5EB" BorderThickness="0,0,0,1" Padding="28,0"><Grid><TextBlock Text="Enterprise document security" VerticalAlignment="Center" Foreground="#657386"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Server" VerticalAlignment="Center" Foreground="#657386" Margin="0,0,10,0"/><TextBox x:Name="ServerUrlInput" Text="http://127.0.0.1:5000" Width="190"/><Button Content="Connect" Click="OnConnect" Margin="10,0,0,0"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1" Margin="28,24,28,0">
    <Grid x:Name="DesignerPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="Policies  /  Watermark Designer" Foreground="#778495" FontSize="11"/><TextBlock Text="Watermark Designer" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="Design your organization's print watermark. Review changes before applying the policy." Foreground="#657386"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
       <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="EnabledCheck" Content="Enable watermark policy" IsChecked="True" Margin="0,0,0,18"/><TextBlock Text="Aa   Text &amp; typography" Style="{StaticResource Section}"/><TextBlock Text="Saved watermarks" Style="{StaticResource Label}"/><ComboBox x:Name="SavedWatermarkCombo" DisplayMemberPath="Name" SelectionChanged="OnSavedWatermarkSelected"/><TextBlock Text="Type your own text below, then name and save your watermark." Foreground="#657386" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="Watermark name" Style="{StaticResource Label}"/><Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PresetNameInput" MaxLength="80" ToolTip="Name for your custom watermark"/><Button Grid.Column="1" Content="Save / update" Click="OnSavePreset" Margin="8,0,0,0"/></Grid><TextBlock Text="Watermark text · type your own or choose a preset" Style="{StaticResource Label}"/><ComboBox x:Name="WatermarkTextCombo" IsEditable="True" Text="CONFIDENTIAL"><ComboBoxItem Content="CONFIDENTIAL"/><ComboBoxItem Content="DO NOT COPY"/><ComboBoxItem Content="DRAFT"/><ComboBoxItem Content="SAMPLE"/></ComboBox>
        <TextBlock Text="Font family" Style="{StaticResource Label}"/><ComboBox x:Name="FontCombo" SelectedIndex="0"><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Times New Roman"/></ComboBox>
        <TextBlock x:Name="FontSizeLabel" Text="Font size · 36 pt" Style="{StaticResource Label}"/><Slider x:Name="FontSizeSlider" Minimum="14" Maximum="90" Value="36"/>
        <TextBlock x:Name="OpacityLabel" Text="Watermark opacity · 18%" Style="{StaticResource Label}"/><Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="1" Value="0.18"/>
        <TextBlock Text="Color · hex" Style="{StaticResource Label}"/><TextBox x:Name="ColorInput" Text="#DC2626" MaxLength="7"/><TextBlock x:Name="ColorError" Foreground="#C42B1C" FontSize="11" TextWrapping="Wrap"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="▧   Layout &amp; logo" Style="{StaticResource Section}"/><TextBlock Text="Placement" Style="{StaticResource Label}"/><ComboBox x:Name="PlacementCombo" SelectedIndex="0"><ComboBoxItem Content="Diagonal center"/><ComboBoxItem Content="Horizontal center"/><ComboBoxItem Content="Top of page"/><ComboBoxItem Content="Bottom of page"/><ComboBoxItem Content="Repeating tiled grid"/></ComboBox>
        <TextBlock x:Name="AngleLabel" Text="Rotation · -45°" Style="{StaticResource Label}"/><Slider x:Name="AngleSlider" Minimum="-180" Maximum="180" Value="-45" TickFrequency="15" IsSnapToTickEnabled="True"/>
        <TextBlock Text="Content mode" Style="{StaticResource Label}"/><ComboBox x:Name="ContentModeCombo" SelectedIndex="0"><ComboBoxItem Content="Text only"/><ComboBoxItem Content="Logo only"/><ComboBoxItem Content="Text + logo"/></ComboBox>
        <WrapPanel Margin="0,16,0,0"><Button x:Name="BrowseImageBtn" Content="Choose PNG / JPG" Click="OnSelectImageClicked"/><Button Content="Remove" Click="OnRemoveImage"/></WrapPanel><TextBlock x:Name="ImageStatus" Foreground="#657386" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="⌘   Metadata &amp; audit" Style="{StaticResource Section}"/><TextBlock Text="Insert dynamic variables into the watermark text." Foreground="#657386" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button Content="Username" Tag="{}{UserName}" Click="OnInsertVariable"/><Button Content="Computer" Tag="{}{ComputerName}" Click="OnInsertVariable"/><Button Content="Date / time" Tag="{}{DateTime}" Click="OnInsertVariable" Margin="0,8,0,0"/></WrapPanel><CheckBox x:Name="BannerCheck" Content="Include security banner" IsChecked="True"/><TextBox x:Name="BannerInput" Text="CONFIDENTIAL - INTERNAL DISTRIBUTION ONLY" Margin="0,10,0,0"/><CheckBox x:Name="FooterCheck" Content="Include audit footer" IsChecked="True"/><CheckBox x:Name="QrCheck" Content="Include encrypted audit QR code" IsChecked="True"/></StackPanel></Border>
       <WrapPanel Margin="0,0,0,20"><Button x:Name="SaveButton" Content="✓  Apply watermark policy" Style="{StaticResource Primary}" Click="OnSaveWatermarkClicked"/><Button Content="Reset" Click="OnReset"/></WrapPanel>
      </StackPanel></ScrollViewer>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Background="#EAF0F6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Background="White" Padding="18" BorderBrush="#DDE4EC" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0"><StackPanel><Grid><TextBlock Text="Live preview" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="●  LIVE" Foreground="#107C10" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><WrapPanel Margin="0,14,0,0"><ComboBox x:Name="PaperCombo" Width="110" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="A4"/><ComboBoxItem Content="US Letter"/></ComboBox><ComboBox x:Name="OrientationCombo" Width="130" SelectedIndex="0"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/></ComboBox></WrapPanel></StackPanel></Border>
       <Viewbox Grid.Row="1" Margin="12" Stretch="Uniform" ToolTip="Illustrative sample document. Changes appear instantly."><local:WatermarkPreview x:Name="Preview" Width="595" Height="842"/></Viewbox>

      </Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="FleetPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Printer fleet" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Discover printer queues and direct-print devices on your network." Foreground="#657386" Margin="0,8,0,20"/><WrapPanel><TextBox x:Name="SubnetInput" Text="auto" Width="160" Margin="0,0,10,0"/><Button Content="Scan fleet" Click="OnRefreshClicked" Style="{StaticResource Primary}"/></WrapPanel></StackPanel><UniformGrid Grid.Row="1" Columns="3" Margin="0,20"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DISCOVERED PRINTERS" Foreground="#657386" FontSize="11"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="30"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="DIRECT SOCKET" Foreground="#657386" FontSize="11"/><TextBlock x:Name="DirectCountText" Text="0" FontSize="30" Foreground="#0F6CBD"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="DRIVER QUEUES" Foreground="#657386" FontSize="11"/><TextBlock x:Name="DriverQueueCountText" Text="0" FontSize="30"/></StackPanel></Border></UniformGrid><DataGrid Grid.Row="2" x:Name="PrintersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" BorderBrush="#E0E5EB" RowHeight="40" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF0F4"><DataGrid.Columns><DataGridTextColumn Header="Device / queue" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="IP / port" Binding="{Binding IpAddress}" Width="*"/><DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="2*"/><DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/><DataGridTextColumn Header="Capability" Binding="{Binding Capability}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
    <Grid x:Name="DeploymentPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,22"><TextBlock Text="Operations  /  Fleet Deployment" Foreground="#778495" FontSize="11"/><TextBlock Text="Fleet Deployment" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock Text="Remotely install and configure PrintMark client on Active Directory workstations via WMI." Foreground="#657386"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="⊞   Domain computers" Style="{StaticResource Section}"/><TextBlock Text="Workstations discovered via Active Directory. Click Discover to scan." Foreground="#657386" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"/><WrapPanel Margin="0,0,0,10"><Button Content="Discover domain computers" Style="{StaticResource Primary}" Click="OnDiscoverComputersClicked"/></WrapPanel></StackPanel>
       <TextBlock Grid.Row="1" x:Name="AdDiscoveryStatus" Text="Ready to discover domain computers." Foreground="#657386" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <ListView Grid.Row="2" x:Name="ComputerListView" SelectionChanged="OnComputerSelectionChanged" BorderBrush="#E0E5EB" Background="#FAFCFE"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#242424"/><TextBlock Text="{Binding DnsHostName}" FontSize="11" Foreground="#657386"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8791A1"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock Text="🚀   Remote push installation" Style="{StaticResource Section}"/><TextBlock Text="Deploy the unified PrintMark installer silently to the remote workstation." Foreground="#657386" Margin="0,4,0,16"/>
       <TextBlock Text="Target workstation" Style="{StaticResource Label}"/><TextBox x:Name="TargetComputerInput" ToolTip="e.g. WORKSTATION-01 or 192.168.0.105"/><TextBlock Text="Select from the domain list or type any network hostname/IP." Foreground="#8791A1" FontSize="11" Margin="0,3,0,0"/>
       <TextBlock Text="Local enterprise installer" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstallerPathInput" Text="PrintMark-Enterprise-Setup.exe"/><Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstallerClicked" Margin="8,0,0,0"/></Grid>
       <TextBlock Text="Remote execution command" Style="{StaticResource Label}"/><TextBox IsReadOnly="True" Background="#F8FAFC" Foreground="#475569" Text="C:\Windows\Temp\PrintMark-Setup.exe /VERYSILENT /SUPPRESSMSGBOXES /COMPONENTS=&quot;client&quot;"/>
       <TextBlock Text="Administrative credentials (optional for remote WMI access)" Style="{StaticResource Label}"/><Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="AdminUserInput" ToolTip="Domain admin username (e.g. CORP\Administrator)"/><PasswordBox Grid.Column="2" x:Name="AdminPasswordInput" VerticalContentAlignment="Center" Padding="10,8" BorderBrush="#D7DEE7" Background="White" ToolTip="Domain admin password"/></Grid><TextBlock Text="Leave blank to use current Windows administrator credentials." Foreground="#8791A1" FontSize="11" Margin="0,0,0,18"/>
       <WrapPanel Margin="0,0,0,16"><Button x:Name="DeployButton" Content="⚡  Deploy client to workstation" Style="{StaticResource Primary}" Click="OnDeployClientClicked"/></WrapPanel>
       <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="DEPLOYMENT STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#657386" Margin="0,0,0,6"/><ProgressBar x:Name="DeploymentProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10" Foreground="#0F6CBD"/><TextBlock x:Name="DeploymentFeedbackText" Text="Ready to deploy." FontSize="13" TextWrapping="Wrap" Foreground="#242424"/></StackPanel></Border>
      </StackPanel></ScrollViewer></Border>
     </Grid>
    </Grid>
    <StackPanel x:Name="HomePanel" Visibility="Collapsed"><TextBlock Text="Protect every printed page." FontSize="36" FontWeight="SemiBold" Margin="0,30,0,16"/><TextBlock Text="Configure dynamic watermarks, preview your policy, and discover your printer fleet." FontSize="16" Foreground="#657386"/><Border Style="{StaticResource Card}" Margin="0,32,0,0" Padding="32"><StackPanel><TextBlock Text="Your document security workspace" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Text, company logos, encrypted audit QR codes, and traceable print metadata — managed in one place." TextWrapping="Wrap" Foreground="#657386" Margin="0,14,0,24"/><WrapPanel><Button Content="Design a watermark" Style="{StaticResource Primary}" Click="OnWatermark"/><Button Content="View printer fleet" Click="OnFleet"/><Button Content="Fleet deployment" Click="OnDeployment"/></WrapPanel></StackPanel></Border></StackPanel>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#E0E5EB" BorderThickness="0,1,0,0" Background="White" Padding="20,10"><TextBlock x:Name="StatusText" Text="Ready." Foreground="#657386" FontSize="11" TextTrimming="CharacterEllipsis"/></Border>
  </Grid>
 </Grid>
</Window>







